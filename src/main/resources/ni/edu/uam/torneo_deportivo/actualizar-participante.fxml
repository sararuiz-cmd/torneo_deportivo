<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            prefHeight="700.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.torneo_deportivo.controllers.ActualizarParticipanteController">

    <content>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="Actualizar participante">
                <font>
                    <Font size="22.0"/>
                </font>
            </Label>

            <Label text="Seleccione un participante de la tabla para editar sus datos."/>

            <TableView fx:id="tablaParticipantes" prefHeight="240">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="colEdad" text="Edad" prefWidth="60"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="95"/>
                    <TableColumn fx:id="colModalidad" text="Modalidad" prefWidth="95"/>
                    <TableColumn fx:id="colDisciplina" text="Disciplina" prefWidth="100"/>
                    <TableColumn fx:id="colCaracteristicas" text="Características" prefWidth="260"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
                </columns>
            </TableView>

            <GridPane hgap="15" vgap="10">
                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" prefWidth="250"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Edad:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtEdad" prefWidth="250"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtTelefono" prefWidth="250"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="cbCategoria" prefWidth="250"
                          GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Género:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbGenero" prefWidth="220"
                          GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Modalidad:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbModalidad" prefWidth="220"
                          GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Disciplina:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cbDisciplina" prefWidth="220"
                          GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <TextField fx:id="txtEstado" prefWidth="220"
                           GridPane.columnIndex="3" GridPane.rowIndex="3"/>
            </GridPane>

            <Label text="Características:"/>

            <HBox spacing="12">
                <CheckBox fx:id="chkFederado" text="Federado"/>
                <CheckBox fx:id="chkExperiencia" text="Experiencia previa"/>
                <CheckBox fx:id="chkDisponibilidad" text="Disponible fin de semana"/>
                <CheckBox fx:id="chkSeguro" text="Seguro deportivo"/>
            </HBox>

            <Label fx:id="lblMensaje" wrapText="true"/>

            <HBox spacing="12">
                <Button text="Actualizar" prefWidth="120" onAction="#onActualizar"/>
                <Button text="Atrás" prefWidth="100" onAction="#onAtras"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
