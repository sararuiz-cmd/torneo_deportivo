<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.torneo_deportivo.controllers.VisualizarParticipantesController">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="25" right="30" bottom="15" left="30"/>
            </padding>

            <Label text="Participantes registrados"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Vista de solo lectura"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaParticipantes"
                   editable="false">
            <columns>
                <TableColumn fx:id="colNombre"
                             text="Nombre"
                             prefWidth="160"/>
                <TableColumn fx:id="colEdad"
                             text="Edad"
                             prefWidth="60"/>
                <TableColumn fx:id="colCategoria"
                             text="Categoría"
                             prefWidth="100"/>
                <TableColumn fx:id="colModalidad"
                             text="Modalidad"
                             prefWidth="100"/>
                <TableColumn fx:id="colDisciplina"
                             text="Disciplina"
                             prefWidth="110"/>
                <TableColumn fx:id="colCaracteristicas"
                             text="Características"
                             prefWidth="300"/>
                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox>
            <padding>
                <Insets top="15" right="30" bottom="25" left="30"/>
            </padding>

            <Button text="Atrás"
                    onAction="#onAtras"
                    prefWidth="120"/>
        </VBox>
    </bottom>

</BorderPane>
