<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15"
      prefHeight="700.0"
      prefWidth="1000.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.torneo_deportivo.controllers.VisualizarParticipantesController">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Participantes registrados">
        <font>
            <Font size="22.0"/>
        </font>
    </Label>

    <TableView fx:id="tablaParticipantes" editable="false" prefHeight="550">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="160"/>
            <TableColumn fx:id="colEdad" text="Edad" prefWidth="60"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="100"/>
            <TableColumn fx:id="colModalidad" text="Modalidad" prefWidth="100"/>
            <TableColumn fx:id="colDisciplina" text="Disciplina" prefWidth="110"/>
            <TableColumn fx:id="colCaracteristicas" text="Características" prefWidth="290"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>

    <Button text="Atrás" prefWidth="100" onAction="#onAtras"/>

</VBox>
