<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.torneo_deportivo.controllers.PrincipalController">

    <top>
        <VBox alignment="CENTER" spacing="8.0"
              style="-fx-background-color: #1f4e78;">
            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>

            <Label text="Sistema de Gestión de Torneo Deportivo"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Administración de participantes"
                   style="-fx-font-size: 15px; -fx-text-fill: white;"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="22.0">
            <padding>
                <Insets top="50" right="80" bottom="50" left="80"/>
            </padding>

            <Label text="Menú principal"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Button text="Registrar estudiante"
                    prefWidth="320"
                    prefHeight="55"
                    onAction="#onRegistrarParticipante"
                    style="-fx-font-size: 16px;"/>

            <Button text="Actualizar datos del participante"
                    prefWidth="320"
                    prefHeight="55"
                    onAction="#onActualizarParticipante"
                    style="-fx-font-size: 16px;"/>

            <Button text="Visualizar participantes"
                    prefWidth="320"
                    prefHeight="55"
                    onAction="#onVisualizarParticipantes"
                    style="-fx-font-size: 16px;"/>
        </VBox>
    </center>

</BorderPane>
